# Google Maps Embed API key (restrict it to http://localhost:3000/* and the Maps Embed API).
# Copy this file to frontend/.env and restart `npm start` after changing it.
REACT_APP_GOOGLE_MAPS_API_KEY=your_key_here

# Optional: call Express directly instead of the CRA dev proxy (default: /api).
# REACT_APP_API_URL=http://127.0.0.1:5000/api
